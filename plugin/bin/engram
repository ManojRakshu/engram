#!/bin/sh
# Engram launcher: self-contained bundle + wasm grammars. Needs nothing preinstalled: it uses your Node.js 22+
# if there is one, otherwise it fetches the official Node.js build once (checksum-verified) into ~/.engram.
SELF="$0" # follow the ~/.local/bin/engram link back to the checkout
while [ -L "$SELF" ]; do L="$(readlink "$SELF")"; case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac; done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) WIN=1 ;; *) WIN= ;; esac
[ -n "$WIN" ] && DIR="$(cd "$DIR" && pwd -W)" # Git Bash on Windows: node.exe wants C:/ paths
export ENGRAM_WASM_DIR="$DIR/dist"
NODE_VER=v22.23.1
EH="${ENGRAM_HOME:-$HOME/.engram}"
NODE="${ENGRAM_NODE:-}"
[ -z "$NODE" ] && [ -x "$EH/node-$NODE_VER/bin/node" ] && NODE="$EH/node-$NODE_VER/bin/node"
[ -z "$NODE" ] && [ -n "$WIN" ] && [ -f "$EH/node-$NODE_VER/node.exe" ] && NODE="$EH/node-$NODE_VER/node.exe"
[ -z "$NODE" ] && NODE="$(command -v node)"
if [ -z "$NODE" ] && [ -n "$WIN" ]; then
  mkdir -p "$EH" && powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$DIR/bin/fetch-node.ps1" "$(cd "$EH" && pwd -W)" >&2 || exit 1
  NODE="$EH/node-$NODE_VER/node.exe"
fi
if [ -z "$NODE" ]; then
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) P=darwin-arm64 ;; Darwin-x86_64) P=darwin-x64 ;;
    Linux-x86_64) P=linux-x64 ;; Linux-aarch64 | Linux-arm64) P=linux-arm64 ;;
    *) echo "engram: please install Node.js 22+ (https://nodejs.org)" >&2; exit 1 ;;
  esac
  F="node-$NODE_VER-$P.tar.gz"
  T="$EH/.node-download-$$"
  echo "engram: fetching Node.js $NODE_VER (one time)…" >&2
  if command -v sha256sum >/dev/null; then SUM="sha256sum -c -"; else SUM="shasum -a 256 -c -"; fi
  get() { for _ in 1 2 3; do curl -fsSL --connect-timeout 20 "$1" -o "$2" && return 0; sleep 2; done; return 1; } # flaky networks
  mkdir -p "$T" &&
    get "https://nodejs.org/dist/$NODE_VER/$F" "$T/$F" &&
    get "https://nodejs.org/dist/$NODE_VER/SHASUMS256.txt" "$T/SUMS" &&
    (cd "$T" && grep " $F\$" SUMS | $SUM >/dev/null) &&
    tar -xzf "$T/$F" -C "$T" &&
    rm -rf "$T/node-$NODE_VER-$P/include" "$T/node-$NODE_VER-$P/share" "$T/node-$NODE_VER-$P/lib" &&
    rm -rf "$EH/node-$NODE_VER" && mv "$T/node-$NODE_VER-$P" "$EH/node-$NODE_VER"
  rm -rf "$T"
  NODE="$EH/node-$NODE_VER/bin/node"
  [ -x "$NODE" ] || { echo "engram: could not fetch Node.js; please install Node.js 22+ (https://nodejs.org)" >&2; exit 1; }
fi
exec "$NODE" --liftoff-only "$DIR/dist/engram.mjs" "$@"
