# FalkorDB (local docker: see docker-compose.yml)
FALKORDB_URL=falkor://localhost:6390
# FALKORDB_URL=falkor://default:<password>@<host>:<port>   # FalkorDB Cloud

# AWS Bedrock (pick ONE auth method) — never commit real values
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# Model used by pi / benchmark (cheap + fast by default)
ENGRAM_MODEL=amazon-bedrock/global.anthropic.claude-haiku-5-5
