{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/probe", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/probe.js", "A-exec-noext"], "timeout": 20 },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/probe.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/probe.js", "B-exec-exe"], "timeout": 20 },
      { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/probe-sh\" C-shell-sh", "timeout": 20 },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/probecmd", "args": ["D-exec-cmd"], "timeout": 20 },
      { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/probecmd.cmd\" E-shell-cmd", "timeout": 20 }
    ] }],
    "PostToolUse": [{ "matcher": "Read|Edit|Write|Bash", "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/probe.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/probe.js", "F-posttool"], "timeout": 20 }
    ] }]
  }
}
