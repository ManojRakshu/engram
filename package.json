{
  "name": "engram-graph",
  "version": "0.1.0",
  "description": "A learning context graph for coding agents, built on FalkorDB",
  "type": "module",
  "license": "MIT",
  "bin": {
    "engram": "./dist/cli.js"
  },
  "scripts": {
    "engram": "tsx src/cli.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --liftoff-only --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
